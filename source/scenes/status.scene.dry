= Internal Factions of the ASPD

{!<span class="tooltip-text" title="The National Revolutionaries are interested in proletarian nationalism, transformative policies and no cooperation with any other parties.">National_Revolutionaries</span>!} strength: [+ National_Revolutionaries_strength : strength +], dissent: [+ left_dissent : dissent +]

{!<span class="tooltip-text" title="The Center is a faction of that supports both active participation in goverment and nationalism.">Center</span>!} strength: [+ center_strength : strength +], dissent: [+ center_dissent : dissent +]

{!<span class="tooltip-text" title="Coalitionists are active participants in government, and seek to expand the welfare state and defend democracy, they represent the original 23 members of the SPD that were expelled due to the formation of a grand coalition.">Coalitionist</span>!} strength: [+ Coalitionist_strength : strength +], dissent: [+ Coalitionist_dissent : dissent +]

@paramilitaries
on-arrival: {!
if (Q.rb_strength) {
    Q.rb_strength_2 = Q.rb_strength.toFixed(1);
}
if (Q.rfb_strength) {
    Q.rfb_strength_2 = Q.rfb_strength.toFixed(1);
}
if (Q.sh_strength) {
    Q.sh_strength_2 = Q.sh_strength.toFixed(1);
}
if (Q.sa_strength) {
    Q.sa_strength_2 = Q.sa_strength.toFixed(1);
}
!}

= Paramilitaries

